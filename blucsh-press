<script>

let cart=[];


function addToCart(name,price,sizeId,colorId){

let size="";

let color="";

if(sizeId!=="none"){

size=document.getElementById(sizeId).value;

}

color=document.getElementById(colorId).value;


cart.push({

name:name,
price:price,
size:size,
color:color

});


updateCart();

alert(name+" added to your beauty bag ♡");

}


function updateCart(){

document.getElementById("cartCount").innerText=cart.length;

let box=document.getElementById("cartItems");

let total=0;

if(cart.length===0){

box.innerHTML=
'<p style="color:#999;">Your bag is empty.</p>';

document.getElementById("cartTotal").innerText="0.00";

return;

}

box.innerHTML="";


cart.forEach(function(item,index){

total+=Number(item.price);

box.innerHTML+=`

<div class="cart-item">

<strong>${item.name}</strong>

<div>
Colour: ${item.color}
</div>

${item.size ? `<div>Size: ${item.size}</div>` : ""}

<div style="margin-top:5px;">
RM${item.price}
</div>

<button
class="remove-button"
onclick="removeItem(${index})">

Remove

</button>

</div>

`;

});


document.getElementById("cartTotal")
.innerText=total.toFixed(2);

}


function removeItem(index){

cart.splice(index,1);

updateCart();

}


function openCart(){

document
.getElementById("cartPanel")
.classList.add("open");

}


function closeCart(){

document
.getElementById("cartPanel")
.classList.remove("open");

}


function checkout(){

if(cart.length===0){

alert("Your beauty bag is empty ♡");

return;

}

alert(
"Thank you for shopping with Blush & Nails! ♡\n\n"+
"This checkout is a demonstration for the e-commerce assignment."
);

}


/* ADMIN */

function adminLogin(){

let password=
document.getElementById("adminPassword").value;

if(password==="blush123"){

document.getElementById("adminLogin").style.display="none";

document.getElementById("adminContent").style.display="block";

displayAdminProducts();

}else{

document.getElementById("loginMessage").innerText=
"Incorrect password.";

document.getElementById("loginMessage").style.color="#c95b7d";

}

}


function addProduct(){

let name=
document.getElementById("newProductName").value;

let price=
document.getElementById("newProductPrice").value;

let category=
document.getElementById("newProductCategory").value;

let image=
document.getElementById("newProductImage").value;


if(!name || !price || !image){

alert("Please fill in all fields.");

return;

}


let product={

name:name,
price:price,
category:category,
image:image

};


let saved=
JSON.parse(localStorage.getItem("beautyProducts") || "[]");

saved.push(product);

localStorage.setItem(
"beautyProducts",
JSON.stringify(saved)
);


alert("Product added successfully ♡");

displayAdminProducts();

}


function displayAdminProducts(){

let box=
document.getElementById("adminProducts");

let saved=
JSON.parse(localStorage.getItem("beautyProducts") || "[]");

if(saved.length===0){

box.innerHTML=
"<p style='color:#999;margin-top:15px;'>No additional products yet.</p>";

return;

}


box.innerHTML="";


saved.forEach(function(product,index){

box.innerHTML+=`

<div class="admin-product">

<div>

<strong>${product.name}</strong>

<br>

<small>
${product.category} • RM${product.price}
</small>

</div>

<button
class="delete"
onclick="deleteProduct(${index})">

Delete

</button>

</div>

`;

});

}


function deleteProduct(index){

let saved=
JSON.parse(localStorage.getItem("beautyProducts") || "[]");

saved.splice(index,1);

localStorage.setItem(
"beautyProducts",
JSON.stringify(saved)
);

displayAdminProducts();

}

</script>

